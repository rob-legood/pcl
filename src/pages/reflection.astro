---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="The Reflection — People Centric Leadership"
  description="A short, guided way to find your footing when you're not sure where to start. Coming in a later stage."
>
  <section class="mx-auto max-w-5xl px-6 py-section-lg sm:px-8">
    <h1 class="font-display text-h1 font-medium tracking-tight text-ink">The Reflection</h1>
    <p class="measure mt-6 text-lead text-ink-muted">
      This will be a short, guided set of questions to help you find your
      footing when you're not sure where to start — pointing you toward the
      part of the site that fits where you are right now.
    </p>
    <p class="measure mt-4 text-body text-ink-muted">
      It isn't built yet. For now, use the{' '}
      <a href="/#where-are-you" class="text-accent hover:text-accent-strong">where are you right now</a>{' '}
      cards on the home page, or browse the sections directly from the nav above.
    </p>
  </section>
</BaseLayout>
