---
import { getEntry } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Toc from '../components/Toc.astro';

const entry = await getEntry('first-90-days', 'manual');
if (!entry) throw new Error('Missing first-90-days entry');

interface ChecklistGroup {
  heading?: string;
  items: string[];
}

interface Phase {
  id: string;
  n: string;
  range: string;
  title: string;
  goal: string;
  groups: ChecklistGroup[];
}

interface ChecklistItemRef {
  itemId: string;
  text: string;
}

const phases: Phase[] = [
  {
    id: 'phase-0',
    n: '0',
    range: 'Before Day 1',
    title: 'Pre-Start',
    goal: "Show up grounded, not anxious. You can't control much yet, so focus on what you can.",
    groups: [
      {
        items: [
          'Research the company publicly: latest earnings or funding, blog posts, press, Glassdoor signal, recent product launches.',
          'Read anything you were given: org chart, strategy decks, handbook, recent all-hands recordings.',
          'Identify (from LinkedIn + your recruiter) the names and rough backgrounds of: your manager, your direct reports, your peer managers, your skip-level.',
          "Draft a one-page self-introduction: who you are, what you've done, what you care about, what to expect from you in the first few weeks. Keep it human, not a resume recap.",
          'Block recurring time on your calendar before it gets eaten: deep work, 1:1s, reflection time, exercise.',
          "Decide on a personal knowledge capture system before info starts flowing: Notion, Obsidian, a single doc, whatever. Don't trust memory.",
          'Rest. Seriously. The first month will spend energy faster than you expect.',
        ],
      },
    ],
  },
  {
    id: 'phase-1',
    n: '1',
    range: 'Week 1',
    title: 'Land',
    goal: 'Meet people, set up logistics, project calm curiosity. Resist the urge to have opinions.',
    groups: [
      {
        heading: 'People',
        items: [
          "Meeting with your manager, to clarify: what does success look like at 30/60/90 days? What's the one thing they wish their last person had done? How do they like to communicate?",
          'First 1:1s with each direct report (30-45 min). Goal is listening, not directing.',
          'Identify peer managers and request intro chats this week or next.',
          'Identify your skip-level and ask your manager when an intro makes sense.',
          'Deliver self-intro to the team (in person, on a call, or async via a written post; match the team\'s medium).',
        ],
      },
      {
        heading: 'Logistics',
        items: [
          'Access: all repos, CI/CD, monitoring, on-call rotation, docs sites, dashboards, communication channels.',
          "Subscribe to the channels and mailing lists your team is in.",
          "Get added to relevant recurring meetings; decline anything that isn't clearly useful yet (you can opt back in).",
        ],
      },
      {
        heading: 'Posture',
        items: [
          'Default to questions, not answers.',
          'Write down things you\'d change. Do not act on them yet.',
          'Notice what energizes and drains each team member in conversation; useful data later.',
        ],
      },
    ],
  },
  {
    id: 'phase-2',
    n: '2',
    range: 'Days 8–30',
    title: 'Listen',
    goal: 'Build a high-resolution map of the people, the work, the systems, and the politics. Earn trust by being curious and useful in small ways.',
    groups: [
      {
        heading: 'Establish 1:1 cadence',
        items: [
          'Weekly 1:1s with each direct report, 30 min, recurring. Their agenda first, then yours.',
          'Bi-weekly or monthly with key peers and skip-level.',
          'A shared 1:1 doc per report: running notes, action items, topics for next time.',
        ],
      },
      {
        heading: 'Listening tour',
        items: [
          "Run a structured set of conversations across the team and adjacent teams: what's working, what's broken, what you'd do first in my seat, who else to talk to, what leadership should know, the biggest risk in the next 6 months.",
          "Track responses in a single doc; themes will emerge by the end of week 3.",
        ],
      },
      {
        heading: 'Get dirty with the code and systems',
        items: [
          "Clone the main repos. Build them locally. Run the tests. Note where setup is painful; that's a signal.",
          'Read the README and architecture docs; flag what\'s stale.',
          'Pair with an engineer on a real task, not to ship, but to feel the developer experience.',
          'Shadow on-call for one rotation if feasible. Read recent incident reviews.',
          'Inventory the major services / repos / domains. Sketch a one-page architecture diagram for yourself.',
        ],
      },
      {
        heading: 'Understand the business',
        items: [
          'Re-read the company mission, vision, values. Find out how recently they were updated and whether anyone references them.',
          "Understand how your team's work ladders up to company priorities. If you can't articulate it in one sentence, you don't understand it yet.",
          'Learn the revenue or impact model. What does a customer pay for? What metric does the company live or die by?',
          "Identify the company's current strategic bets and how the team fits in.",
        ],
      },
      {
        heading: 'Audit existing metrics',
        items: [
          'Inventory what\'s already measured: business KPIs, product metrics, engineering health metrics (DORA, incident rates, on-call load), people metrics (eNPS, attrition).',
          'For each metric: who owns it, where it lives, who looks at it, what action it drives.',
          'Note which decisions are made with data vs. without, and which metrics are vanity vs. actionable.',
        ],
      },
      {
        heading: 'Stakeholder map',
        items: [
          "List everyone whose work depends on yours or whose work you depend on. Categorize by influence and interest. Plan how often you'll engage each.",
        ],
      },
      {
        heading: 'Personal systems',
        items: [
          'Stand up a todo / work tracker (e.g., a daily list in a doc, Things, Linear, Todoist; pick one and commit for 90 days).',
          "Weekly review ritual: 30 minutes Friday afternoon; what happened, what's next, what's blocked.",
          'Reading queue for things you want to come back to.',
          'Decision log: when you make a non-trivial decision, write down the context, options, choice, and expected outcome. Revisit in 3 months.',
        ],
      },
    ],
  },
  {
    id: 'phase-3',
    n: '3',
    range: 'Days 31–60',
    title: 'Diagnose',
    goal: 'Synthesize what you\'ve learned. Start forming a point of view. Begin small, visible improvements.',
    groups: [
      {
        items: [
          'Write a private assessment doc for yourself: state of the team, top 5 risks, top 5 opportunities, what kind of leadership the moment calls for (turnaround? steady state? acceleration?).',
          'Share a sanitized version with your manager and ask for pushback.',
          "Identify 1-3 quick wins: visible improvements you can deliver in 2-4 weeks that don't require strategy buy-in. Examples: fix a hated meeting, clarify on-call expectations, kill a useless metric, improve a broken doc.",
          "Begin defining your own metrics: what you want to track that isn't already tracked. Examples: % of 1:1s where the report drove the agenda, time-to-first-PR for new hires, weekly hours in meetings vs. deep work.",
          "Identify any urgent personnel issues. Don't sit on them, but don't fire from the hip either.",
          "Confirm or revise your understanding of the team's mandate with your manager.",
        ],
      },
    ],
  },
  {
    id: 'phase-4',
    n: '4',
    range: 'Days 61–90',
    title: 'Shape',
    goal: 'Move from observer to author. Commit to a direction. Communicate it clearly.',
    groups: [
      {
        items: [
          "Draft a team operating plan: mission, priorities for the next 1-2 quarters, what you'll stop doing, what success looks like.",
          'Socialize the plan with peers and manager before announcing it to the team. Refine.',
          'Present the plan to the team. Invite challenge. Adjust.',
          "Define and communicate your operating rhythms: meeting cadence, decision-making process, how you'll give and receive feedback, what you'll escalate and what you won't.",
          'Set up a recurring forum for team announcements and visibility (weekly written update, monthly all-hands, whatever fits).',
          "Begin the first goal-setting cycle under your leadership if the calendar allows.",
        ],
      },
    ],
  },
];

// Stable per-item ids for the localStorage-backed progress tracker,
// derived from position, since phase/group/item order is static content.
const itemIdsByPhase: Record<string, ChecklistItemRef[]> = {};
for (const phase of phases) {
  const refs: ChecklistItemRef[] = [];
  phase.groups.forEach((group, gi) => {
    group.items.forEach((item, ii) => {
      refs.push({ itemId: `${phase.id}--${gi}-${ii}`, text: item });
    });
  });
  itemIdsByPhase[phase.id] = refs;
}
const totalItems = Object.values(itemIdsByPhase).reduce((sum, refs) => sum + refs.length, 0);

// Serialized for the client-side "Save as Markdown" export, so it stays in
// sync with the checklist content without re-scraping rendered DOM text.
const exportData = {
  title: entry.data.title,
  phases: phases.map((phase) => ({
    range: phase.range,
    title: phase.title,
    goal: phase.goal,
    groups: phase.groups.map((group, gi) => ({
      heading: group.heading ?? null,
      items: group.items.map((text, ii) => ({ itemId: `${phase.id}--${gi}-${ii}`, text })),
    })),
  })),
};

const cadence = [
  {
    title: 'Weekly',
    items: [
      '1:1s with all direct reports.',
      "Friday review: what shipped, what's stuck, what's next week's top 3.",
      'One written update to your team or broader org (even short).',
    ],
  },
  {
    title: 'Monthly',
    items: [
      'Skip-level conversations (rotate).',
      'Metric review with the team.',
      'One "no agenda" coffee with a peer in another part of the org.',
      'Personal reflection: am I doing the job I was hired to do, or am I hiding in the comfortable parts?',
    ],
  },
  {
    title: 'Quarterly',
    items: [
      'Goal review and reset.',
      '360-style feedback solicitation (informal is fine).',
      'Career conversations with each direct report.',
      'Update this manual.',
    ],
  },
  {
    title: 'Annually',
    items: [
      'Performance reviews.',
      'Compensation cycle.',
      'Strategy planning for the team.',
      'A real vacation. Disconnect.',
    ],
  },
];

const watchOutFor = [
  "Making big changes before you've earned the right to.",
  'Confusing motion for progress.',
  'Becoming the bottleneck. Your job is to multiply, not to do.',
  "Letting your calendar fill with meetings that aren't moving the team forward.",
  "Withholding hard feedback because it's uncomfortable.",
  'Forgetting that your direct reports read your mood, your calendar, and your Slack response times as signals.',
];

const tocItems = [
  ...phases.map((p) => ({ id: p.id, label: `Phase ${p.n}: ${p.title}` })),
  { id: 'operating-system', label: 'Ongoing operating system' },
  { id: 'watch-out-for', label: 'Things to watch out for' },
];
---

<BaseLayout title={`${entry.data.title}: People Centric Leadership`} description={entry.data.description}>
  <div class="mx-auto max-w-5xl px-6 py-section sm:px-8">
    <header class="max-w-3xl">
      <h1 class="font-display text-h1 font-medium tracking-tight text-ink">
        {entry.data.title}
      </h1>
      <p class="measure mt-6 text-lead text-ink-muted">
        This is the manual I use when I step into a new role. I wrote it for myself — 
        the sequence I want to follow when I'm new, overwhelmed, and tempted to have 
        opinions before I've earned them. If you're stepping into something similar, 
        it's yours to use.
      </p>
      <p class="measure mt-4 text-body text-ink-muted">
        Suggested rhythm: review the relevant phase at the start of each
        week, reflect for five minutes at the end of each week, and revisit
        the whole manual after each transition to prune.
      </p>

      <div class="measure mt-10 rounded-lg border border-hairline bg-paper-raised p-5">
        <div class="flex items-center justify-between gap-4">
          <p class="text-xs uppercase tracking-wide text-ink-muted">
            <span data-progress-count>0 / {totalItems}</span> milestones checked
          </p>
          <div class="no-print flex items-center gap-4">
            <button
              type="button"
              data-action="export-markdown"
              class="text-xs uppercase tracking-wide text-ink-muted underline decoration-dotted hover:text-accent"
            >
              Save as Markdown
            </button>
            <button
              type="button"
              data-action="reset-progress"
              class="text-xs uppercase tracking-wide text-ink-muted underline decoration-dotted hover:text-accent"
            >
              Reset progress
            </button>
          </div>
        </div>
        <div class="mt-3 h-1.5 w-full rounded-full bg-hairline">
          <div data-progress-bar class="h-1.5 rounded-full bg-accent transition-[width]" style="width: 0%" />
        </div>
        <p class="no-print mt-3 text-xs text-ink-muted">
          Checking a box saves your progress in this browser only; nothing
          is sent anywhere. Clear your browser data and it resets.
        </p>
      </div>
    </header>

    <div class="mt-4 lg:grid lg:grid-cols-[1fr_240px] lg:gap-16">
      <Toc items={tocItems} />

      <article class="min-w-0 lg:col-start-1 lg:row-start-1">
        <ol class="relative space-y-16 border-l border-hairline pl-10 sm:pl-12">
          {
            phases.map((phase) => (
              <li id={phase.id} class="relative scroll-mt-8">
                <span class="absolute -left-[3.25rem] flex h-9 w-9 items-center justify-center rounded-full border border-hairline bg-paper font-display text-sm text-ink sm:-left-[3.75rem]">
                  {phase.n}
                </span>
                <div class="flex items-baseline justify-between gap-4">
                  <p class="text-xs uppercase tracking-wide text-accent">{phase.range}</p>
                  <p data-phase-progress={phase.id} class="text-xs text-ink-muted">
                    0 / {itemIdsByPhase[phase.id].length}
                  </p>
                </div>
                <h2 class="mt-1 font-display text-h3 font-medium tracking-tight text-ink">{phase.title}</h2>
                <p class="measure mt-3 text-body text-ink-muted">
                  <strong class="text-ink">Goal:</strong> {phase.goal}
                </p>

                <div class="mt-8 space-y-8">
                  {phase.groups.map((group, gi) => (
                    <div>
                      {group.heading && (
                        <h3 class="font-display text-base font-medium text-ink">{group.heading}</h3>
                      )}
                      <ul class:list={['space-y-3', group.heading && 'mt-3']}>
                        {group.items.map((item, ii) => {
                          const itemId = `${phase.id}--${gi}-${ii}`;
                          return (
                            <li class="flex text-body text-ink-muted">
                              <label class="flex cursor-pointer gap-3">
                                <input
                                  type="checkbox"
                                  id={itemId}
                                  data-tracker-item
                                  data-phase={phase.id}
                                  class="peer sr-only"
                                />
                                <span
                                  aria-hidden="true"
                                  class="mt-1.5 flex h-3.5 w-3.5 flex-none items-center justify-center rounded-[3px] border border-hairline peer-checked:border-accent peer-checked:bg-accent"
                                >
                                  <svg viewBox="0 0 12 12" class="h-2.5 w-2.5 text-paper opacity-0 peer-checked:opacity-100">
                                    <path
                                      d="M2.25 6.25L4.75 8.75L9.5 3.5"
                                      fill="none"
                                      stroke="currentColor"
                                      stroke-width="1.5"
                                      stroke-linecap="round"
                                      stroke-linejoin="round"
                                    />
                                  </svg>
                                </span>
                                <span class="peer-checked:text-ink-muted/60 peer-checked:line-through">{item}</span>
                              </label>
                            </li>
                          );
                        })}
                      </ul>
                    </div>
                  ))}
                </div>
              </li>
            ))
          }
        </ol>

        <section id="operating-system" class="mt-16 scroll-mt-8 border-t border-hairline pt-16">
          <h2 class="font-display text-h2 font-medium tracking-tight text-ink">
            Ongoing operating system
          </h2>
          <p class="measure mt-4 text-body text-ink-muted">
            Once the first 90 days are behind you, what does steady-state
            look like?
          </p>

          <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
            {
              cadence.map((block) => (
                <div class="rounded-lg border border-hairline bg-paper-raised p-6">
                  <h3 class="font-display text-lg font-medium text-ink">{block.title}</h3>
                  <ul class="mt-4 space-y-3">
                    {block.items.map((item) => (
                      <li class="text-sm text-ink-muted">{item}</li>
                    ))}
                  </ul>
                </div>
              ))
            }
          </div>
        </section>

        <section id="watch-out-for" class="mt-16 scroll-mt-8 border-t border-hairline pt-16">
          <h2 class="font-display text-h2 font-medium tracking-tight text-ink">
            Things to watch out for
          </h2>
          <ul class="measure mt-6 space-y-4">
            {
              watchOutFor.map((item) => (
                <li class="flex gap-3 border-l-2 border-hairline pl-4 text-body text-ink-muted">
                  <span>{item}</span>
                </li>
              ))
            }
          </ul>
        </section>
      </article>
    </div>
  </div>

  <script type="application/json" id="checklist-export-data" is:inline set:html={JSON.stringify(exportData)} />
</BaseLayout>

<script>
  const STORAGE_KEY = 'pcl:first-90-days:progress';

  const checkboxes = Array.from(document.querySelectorAll<HTMLInputElement>('[data-tracker-item]'));
  const overallCount = document.querySelector<HTMLElement>('[data-progress-count]');
  const overallBar = document.querySelector<HTMLElement>('[data-progress-bar]');
  const resetButton = document.querySelector<HTMLButtonElement>('[data-action="reset-progress"]');
  const exportButton = document.querySelector<HTMLButtonElement>('[data-action="export-markdown"]');

  function readState(): Record<string, boolean> {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      return raw ? JSON.parse(raw) : {};
    } catch {
      return {};
    }
  }

  function writeState(state: Record<string, boolean>) {
    try {
      localStorage.setItem(STORAGE_KEY, JSON.stringify(state));
    } catch {
      /* localStorage unavailable, checkboxes still work for this session */
    }
  }

  function updateProgress() {
    const total = checkboxes.length;
    const done = checkboxes.filter((cb) => cb.checked).length;

    if (overallCount) overallCount.textContent = `${done} / ${total}`;
    if (overallBar) overallBar.style.width = `${total ? (done / total) * 100 : 0}%`;

    const phaseGroups = new Map<string, HTMLInputElement[]>();
    for (const cb of checkboxes) {
      const phase = cb.dataset.phase ?? '';
      const list = phaseGroups.get(phase) ?? [];
      list.push(cb);
      phaseGroups.set(phase, list);
    }
    for (const [phase, items] of phaseGroups) {
      const badge = document.querySelector<HTMLElement>(`[data-phase-progress="${phase}"]`);
      if (!badge) continue;
      const phaseDone = items.filter((cb) => cb.checked).length;
      badge.textContent = `${phaseDone} / ${items.length}`;
    }
  }

  const state = readState();
  for (const cb of checkboxes) {
    if (state[cb.id]) cb.checked = true;
  }
  updateProgress();

  for (const cb of checkboxes) {
    cb.addEventListener('change', () => {
      const next = readState();
      if (cb.checked) next[cb.id] = true;
      else delete next[cb.id];
      writeState(next);
      updateProgress();
    });
  }

  resetButton?.addEventListener('click', () => {
    if (!confirm('Reset all checked progress on this page? This can’t be undone.')) return;
    writeState({});
    for (const cb of checkboxes) cb.checked = false;
    updateProgress();
  });

  interface ExportItem {
    itemId: string;
    text: string;
  }
  interface ExportGroup {
    heading: string | null;
    items: ExportItem[];
  }
  interface ExportPhase {
    range: string;
    title: string;
    goal: string;
    groups: ExportGroup[];
  }
  interface ExportData {
    title: string;
    phases: ExportPhase[];
  }

  exportButton?.addEventListener('click', () => {
    const dataEl = document.getElementById('checklist-export-data');
    if (!dataEl?.textContent) return;
    const exportData: ExportData = JSON.parse(dataEl.textContent);
    const state = readState();

    const total = checkboxes.length;
    const done = checkboxes.filter((cb) => cb.checked).length;

    const lines: string[] = [
      `# ${exportData.title}`,
      '',
      `Progress: ${done} / ${total} milestones checked`,
      `Exported: ${new Date().toLocaleDateString()}`,
      '',
    ];

    for (const phase of exportData.phases) {
      lines.push(`## ${phase.title} (${phase.range})`, '', `**Goal:** ${phase.goal}`, '');
      for (const group of phase.groups) {
        if (group.heading) lines.push(`### ${group.heading}`, '');
        for (const item of group.items) {
          lines.push(`- [${state[item.itemId] ? 'x' : ' '}] ${item.text}`);
        }
        lines.push('');
      }
    }

    const blob = new Blob([lines.join('\n')], { type: 'text/markdown;charset=utf-8' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'first-90-days-checklist.md';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  });
</script>
