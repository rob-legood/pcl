---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const templates = await getCollection('templates');

const tiers: { key: (typeof templates)[number]['data']['tier']; label: string; blurb: string }[] = [
  {
    key: 'daily-weekly',
    label: 'Daily & Weekly',
    blurb: 'The rhythm-keepers — small, recurring, easy to skip and costly when skipped.',
  },
  {
    key: 'onboarding-transitions',
    label: 'Onboarding & Transitions',
    blurb: 'For stepping into a role, a team, or a season of change.',
  },
  {
    key: 'engineering-rituals',
    label: 'Engineering Rituals',
    blurb: 'The technical-team rituals that keep quality and context from decaying.',
  },
];
---

<BaseLayout
  title="Templates — People Centric Leadership"
  description="Copy-paste templates for the recurring rituals of the job — 1:1s, reviews, postmortems, RFCs."
>
  <section class="mx-auto max-w-5xl px-6 py-section sm:px-8">
    <h1 class="font-display text-h1 font-medium tracking-tight text-ink">Templates</h1>
    <p class="measure mt-4 text-lead text-ink-muted">
      Copy, paste, adapt. These exist to lower the cost of doing the right
      thing consistently — not to be filled out for their own sake.
    </p>

    {
      tiers.map((tier) => {
        const entries = templates
          .filter((entry) => entry.data.tier === tier.key)
          .sort((a, b) => a.data.order - b.data.order);
        return (
          <div class="mt-12">
            <h2 class="font-display text-h3 font-medium text-ink">{tier.label}</h2>
            <p class="mt-1 text-sm text-ink-muted">{tier.blurb}</p>
            <ul class="mt-6 grid gap-6 sm:grid-cols-2">
              {entries.map((entry) => (
                <li>
                  <a
                    href={`/templates/${entry.id}`}
                    class="block h-full rounded-lg border border-hairline bg-paper-raised p-6 no-underline transition-colors hover:border-accent"
                  >
                    <h3 class="font-display text-lg font-medium text-ink">{entry.data.title}</h3>
                    <p class="mt-2 text-sm text-ink-muted">{entry.data.usageNote}</p>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        );
      })
    }
  </section>
</BaseLayout>
